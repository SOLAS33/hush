{
  "name": "hush",
  "version": "1.0.0",
  "private": true,
  "description": "Hush: hide a short message in a photograph, send it through WhatsApp, reveal it on the other side. Runs entirely on the device.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --import tsx tests/e2e/run.ts && node --import tsx tests/e2e/ui.ts",
    "report": "node --import tsx tools/robustness-report.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "puppeteer-core": "^24.2.0",
    "sharp": "0.33.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
