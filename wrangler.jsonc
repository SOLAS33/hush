{
  // Hush is static files only: no Worker code, no database, no storage. Cloudflare serves ./dist with the headers in dist/_headers.
  "name": "hush",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [{ "pattern": "hush.solas33.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
